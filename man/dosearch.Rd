# The variants of a formula derived by case-by-case reasoning
x <- dosearch(
  "p(y*,r_y = 1) \n p(y,r_y = 0)",
  "p(y|r_y)",
  "y -> r_y",
  missing_data = "r_y : y",
  case_reasoning = TRUE
)
get_formula(x, variants = TRUE)

